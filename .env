# PlexTracker — default config (committed)
# Secret values go in .env.local (gitignored)

###> google oauth ###
GOOGLE_CLIENT_ID=dev
GOOGLE_ALLOWED_EMAIL=dev@localhost
###< google oauth ###

###> jwt login ###
JWT_SECRET=dev-secret-change-me
###< jwt login ###

###> dev login (local only, never enable in prod) ###
DEBUG_LOGIN=false
DEBUG_LOGIN_USER=
DEBUG_LOGIN_PASSWORD=
###< dev login ###

###> external apis (optional) ###
TMDB_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
GEMINI_API_KEY=
###< external apis ###

###> plex webhook ###
PLEX_WEBHOOK_SECRET=
###< plex webhook ###

###> web push (optional) ###
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost
###< web push ###
