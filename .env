# Trackarr — default config (committed)
# Secret values go in .env.local (gitignored)

###> google oauth ###
GOOGLE_CLIENT_ID=dev
GOOGLE_ALLOWED_EMAIL=dev@localhost
###< google oauth ###

###> jwt login ###
JWT_SECRET=dev-secret-change-me
###< jwt login ###

###> cookie ###
# Set to true in production when behind HTTPS
COOKIE_SECURE=false
###< cookie ###

###> external apis (optional) ###
TMDB_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
GEMINI_API_KEY=
###< external apis ###

###> jellyfin webhook ###
JELLYFIN_WEBHOOK_SECRET=
###< jellyfin webhook ###

###> web push (optional) ###
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
###< web push ###
