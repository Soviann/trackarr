# Trackarr — Environment Configuration Template
# Copy this file to .env.local to override settings.
# Note: Most settings can also be dynamically configured via the Web UI at /admin/settings.

# --- System & User Permissions ---
PUID=1000
PGID=1000
TZ=Europe/Paris
DATA_DIR=/data
COOKIE_SECURE=false

# --- Authentication ---
# JWT secret for signing session cookies.
# If left empty, a secure random key is auto-generated and persisted in SQLite.
JWT_SECRET=

# Google OAuth (Optional — leave empty if using local password authentication)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAIL=

# --- External Metadata APIs (Optional) ---
# TheMovieDB API key (v3) for movie/series enrichment and poster downloads
TMDB_API_KEY=

# TheTVDB API key (v4) for episode listings and series metadata
TVDB_API_KEY=

# Google Gemini API key(s) for smart matching (comma-separated for automatic rotation)
GEMINI_API_KEYS=

# AniList OAuth (Client ID & Secret) for anime progress and score synchronization
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- Media Server Webhooks ---
# Secret tokens to secure incoming scrobble webhooks
PLEX_WEBHOOK_SECRET=
JELLYFIN_WEBHOOK_SECRET=

# --- Download Stack (Radarr / Sonarr / Prowlarr) ---
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=

# --- Web Push Notifications (VAPID) ---
# If left empty, NIST P-256 keys are automatically generated on first boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
